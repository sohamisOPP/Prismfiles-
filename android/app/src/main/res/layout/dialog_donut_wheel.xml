<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_donut_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Convert format"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/tv_donut_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select target format"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 120fps hardware-accelerated Radial Donut View (Signature Moment) -->
    <com.prismfiles.app.DonutWheelView
        android:id="@+id/donut_wheel_view"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_donut_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary" />
</LinearLayout>
