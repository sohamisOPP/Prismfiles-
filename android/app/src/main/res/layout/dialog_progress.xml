<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_dialog_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        tools:text="Creating 7z Archive..." />

    <TextView
        android:id="@+id/tv_dialog_task_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Processing: video_01.mp4" />

    <ProgressBar
        android:id="@+id/pb_dialog_task"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/monochrome_white" />

    <TextView
        android:id="@+id/tv_dialog_task_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:fontFamily="monospace"
        tools:text="45% | 14 / 32 items | 120.4 MB / 268 MB" />

    <!-- Action Buttons: Hide (minimizes to notification), Pause/Resume, Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_task_hide"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hide"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_dialog_task_pause"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Pause"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_dialog_task_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Cancel"
            android:textColor="@color/accent_danger" />
    </LinearLayout>
</LinearLayout>
