<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amoled_black"
    android:fitsSystemWindows="true">

    <!-- Main Content Root -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/amoled_black">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Compact One-Line Top Toolbar (#121212) -->
            <LinearLayout
                android:id="@+id/top_toolbar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/toolbar_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/btn_drawer_toggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Navigation Drawer"
                    android:padding="8dp"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/text_primary" />

                <!-- One-line Title & Active Folder Name with Clickable Path Dropdown -->
                <LinearLayout
                    android:id="@+id/header_path_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="PrismFiles"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="/"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_active_folder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="Download" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_drop"
                        app:tint="@color/text_muted" />
                </LinearLayout>

                <!-- Overflow 3-dots Menu & Actions -->
                <ImageView
                    android:id="@+id/btn_multi_select"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Multi-Select"
                    android:padding="9dp"
                    android:src="@drawable/ic_checklist"
                    android:visibility="gone"
                    app:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btn_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search"
                    android:padding="9dp"
                    android:src="@drawable/ic_search"
                    android:visibility="gone"
                    app:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btn_sort"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sort"
                    android:padding="9dp"
                    android:src="@drawable/ic_sort"
                    android:visibility="gone"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/btn_support_dev"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_support_pill"
                    android:clickable="true"
                    android:contentDescription="Support the developer"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_support"
                        app:tint="@color/icon_apk" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Support"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_overflow_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More Options"
                    android:padding="9dp"
                    android:src="@drawable/ic_more"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_line" />

            <!-- In-line Filter Search Bar (Expandable) -->
            <LinearLayout
                android:id="@+id/search_bar_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/toolbar_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_search_query"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_search_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close search"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Selection Mode Header Bar -->
            <LinearLayout
                android:id="@+id/selection_action_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/surface_raised"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_selection_cancel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close selection"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_selection_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="normal"
                    tools:text="3 selected" />

                <!-- Select All -->
                <ImageView
                    android:id="@+id/btn_select_all"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Select All"
                    android:padding="9dp"
                    android:src="@drawable/ic_checklist"
                    app:tint="@color/text_primary" />

                <!-- Copy -->
                <ImageView
                    android:id="@+id/btn_selection_copy"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy selected"
                    android:padding="9dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_primary" />

                <!-- Cut -->
                <ImageView
                    android:id="@+id/btn_selection_cut"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cut selected"
                    android:padding="9dp"
                    android:src="@drawable/ic_cut"
                    app:tint="@color/text_primary" />

                <!-- Compress -->
                <ImageView
                    android:id="@+id/btn_selection_compress"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Compress selected"
                    android:padding="9dp"
                    android:src="@drawable/ic_archive"
                    app:tint="@color/text_primary" />

                <!-- Delete -->
                <ImageView
                    android:id="@+id/btn_selection_delete"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete selected"
                    android:padding="9dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- File List RecyclerView: instant single-frame rendering, zero bouncy scroll -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_file_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="72dp" />
        </LinearLayout>

        <!-- Floating Action Button: morphs between '+' and Clipboard Paste with badge -->
        <FrameLayout
            android:id="@+id/fab_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Actions"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/monochrome_white"
                app:elevation="3dp"
                app:tint="@color/amoled_black" />

            <!-- Live Item Count Badge on Paste Button -->
            <TextView
                android:id="@+id/tv_fab_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_violet"
                android:gravity="center"
                android:textColor="@color/amoled_black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2"
                tools:visibility="visible" />
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Left Navigation Drawer for instant storage jumps -->
    <LinearLayout
        android:id="@+id/navigation_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/toolbar_surface"
        android:orientation="vertical">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/amoled_black"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PrismFiles"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_line" />

        <!-- Storage & Shortcut List in Drawer -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_drawer_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_line" />

        <!-- Quick Launch Utilities Row -->
        <LinearLayout
            android:id="@+id/btn_drawer_tools"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_more"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Utilities"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
